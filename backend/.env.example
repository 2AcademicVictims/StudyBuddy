# Multi-LLM API Keys Configuration Template
# Copy this file to .env and add your actual API keys
# NEVER commit your actual .env file to version control!

# Claude (Anthropic) - Get from: https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChatGPT (OpenAI) - Get from: https://platform.openai.com/api-keys
# Format: sk-proj-... or sk-...
OPENAI_API_KEY=your_openai_api_key_here

# Gemini (Google) - Get from: https://aistudio.google.com/app/apikey
# Format: AIza...
# FREE TIER AVAILABLE!
GOOGLE_API_KEY=your_google_api_key_here

# Groq - Get from: https://console.groq.com/keys
# Format: gsk_...
# FREE TIER AVAILABLE!
GROQ_API_KEY=your_groq_api_key_here

# Notes:
# - Only .env is used by the application (not .env.example)
# - You need at least ONE valid API key for the app to work
# - Free options: Google Gemini and Groq offer generous free tiers
# - The app will automatically use only available/configured models
